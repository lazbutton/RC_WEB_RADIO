# Copier vers /etc/radio/radio.env (chmod 600, root:root).
# Remplir avant de décommenter output.icecast dans radio.liq.

ICECAST_HOST=radio.exemple.org
ICECAST_PORT=8000
ICECAST_MOUNT=/radio.mp3
ICECAST_PASSWORD=change-me
RADIO_NAME=RC Web Radio
RADIO_DESC=Flux en préparation
RADIO_URL=https://radio.exemple.org
