{% extends 'layout.jinja' %}
{% block title %}Connexion{% endblock title %}

{% from 'macros.jinja' import password_field %}
{% block content %}
<main class="suite-login">
    <form method="POST"
        class="suite-login-card"
        hx-post="{{ url_for('login.log_in') }}"
        hx-disabled-elt="find button[type=submit]"
        >
        <div class="suite-login-brand">
            <img src="{{ url_for('static', filename='logo.svg') }}" alt="">
            <h1>{{ config['INTERFACE_NAME'] }}</h1>
            <p>{{ config.get('SUITE_LOGIN', 'Accès studio') }}</p>
        </div>
        <div class="field">
            <label for="username" class="label">Identifiant</label>
            <div class="control">
                <input type="text" name="username" id="username" class="input" autocomplete="username" required>
            </div>
        </div>
        {{ password_field("Mot de passe", stacked=true) }}
        <div class="field">
            <button type="submit" class="button is-primary">
                Entrer
            </button>
        </div>
    </form>
</main>
{% endblock content %}
